# Required bridge auth token (server-only)
PRESENTONIKA_BRIDGE_TOKEN=strong-secret-token

# Optional converter/admin values (examples)
CONVERTER_URL=http://converter:3001
ADMIN_IMPORT_TOKEN=devtoken

# Required for save-fallback in POST /api/bridge/stage-outzip
BRIDGE_SAVE_TOKEN_VALIDATE_URL=https://www.presentonika.ru/wp-json/presentonika/v1/validate-save-token

# Optional bearer for validator endpoint
BRIDGE_SAVE_TOKEN_VALIDATE_BEARER=7ukdfXUG83OMCRjSyRyoUNZvI1SmBQgDbWauiq0MB2TItkEd

# Optional Yandex Image Search integration for POST /api/images/search
YANDEX_SEARCH_FOLDER_ID=
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_DEFAULT_TYPE=SEARCH_TYPE_RU
YANDEX_SEARCH_FAMILY_MODE=FAMILY_MODE_STRICT
YANDEX_SEARCH_FIX_TYPO_MODE=FIX_TYPO_MODE_ON
YANDEX_SEARCH_DOCS_ON_PAGE_DEFAULT=8
YANDEX_SEARCH_TIMEOUT_MS=6000
YANDEX_SEARCH_CACHE_TTL_MS=300000
YANDEX_SEARCH_ENABLE=true
